{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Start MongoDB Daemon",
      "type": "shell",
      "command": "& 'C:\\Program Files\\MongoDB\\Server\\9.0\\bin\\mongod.exe' --dbpath '${workspaceFolder}\\backend\\data\\db' --port 27017",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "2. Seed Database",
      "type": "shell",
      "command": "node seedData.js",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "3. Start Backend Server",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
